<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Simulador de Dispensador"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvNivelComida"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nivel de Comida: 39%"
        android:layout_marginBottom="8dp" />

    <SeekBar
        android:id="@+id/sbComida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="39"
        android:layout_marginBottom="20dp" />

    <Switch
        android:id="@+id/swPresencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mascota Presente"
        android:checked="true"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/tvEstadoCompuerta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Compuerta: CERRADA"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF0000"
        android:layout_marginBottom="32dp" />

    <!-- Botón para dispensar comida -->
    <Button
        android:id="@+id/btnDispensarManual"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="DISPENSAR COMIDA"
        android:layout_marginBottom="12dp" />

    <!-- Botón Cancelar -->
    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CANCELAR ACCIÓN"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_marginBottom="8dp" />

    <!-- Botón Regresar -->
    <Button
        android:id="@+id/btnRegresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGRESAR"
        style="?attr/borderlessButtonStyle" />

</LinearLayout>